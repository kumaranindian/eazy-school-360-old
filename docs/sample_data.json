  "firestore_structure": {
    "collections": {
      "users": {
        "description": "Firebase Auth user profiles",
        "fields": {
          "email": "string",
          "displayName": "string",
          "role": "string (super_admin | tenant_admin | teacher)",
          "schoolId": "string (reference to schools collection)",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp",
          "createdByAdmin": "boolean"
        }
      },
      "schools": {
        "description": "School/tenant information",
        "fields": {
          "name": "string",
          "address": "string",
          "phone": "string",
          "email": "string",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "subcollections": ["leaveTypes", "leaves", "leaveBalances", "salaryStructures", "payroll", "attendance", "settings"]
      },
      "staff": {
        "description": "All staff members (teaching and non-teaching)",
        "fields": {
          "schoolId": "string",
          "userId": "string (Firebase Auth UID if login enabled)",
          "firstName": "string",
          "lastName": "string",
          "email": "string",
          "phone": "string",
          "staffType": "string (teaching | nonTeaching)",
          "subCategory": "string",
          "role": "string (teacher | non_teaching_staff | office_staff)",
          "isActive": "boolean",
          "isLoginRequired": "boolean",
          "authCreated": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },
      "adminUsers": {
        "description": "Admin users for admin provisioning",
        "fields": {
          "userId": "string (Firebase Auth UID)",
          "schoolId": "string",
          "name": "string",
          "email": "string",
          "phone": "string",
          "roles": "array of strings (hr_admin | payroll_admin | attendance_admin | academic_admin | tenant_admin)",
          "isActive": "boolean",
          "lastLoginAt": "timestamp",
          "createdBy": "string",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },
      "leaveRequests": {
        "description": "Leave applications from staff",
        "fields": {
          "schoolId": "string",
          "staffId": "string",
          "staffName": "string",
          "staffType": "string",
          "leaveTypeId": "string",
          "leaveTypeName": "string",
          "startDate": "timestamp",
          "endDate": "timestamp",
          "reason": "string",
          "attachmentUrls": "array of strings",
          "status": "string (pending | approved | rejected | cancelled)",
          "remarks": "string",
          "approvedBy": "string",
          "approvedByName": "string",
          "approvedAt": "timestamp",
          "isHalfDay": "boolean",
          "halfDayType": "string (first_half | second_half)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    }
  }
}
