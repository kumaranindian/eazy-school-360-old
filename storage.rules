rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isActive() {
      return request.auth.token.isActive == true;
    }
    
    function isTenantAdmin() {
      return request.auth.token.role == 'tenant_admin';
    }
    
    function isSuperAdmin() {
      return request.auth.token.role == 'super_admin';
    }
    
    function isTeacher() {
      return request.auth.token.role == 'teacher';
    }
    
    function belongsToSchool(schoolId) {
      return request.auth.token.schoolId == schoolId;
    }
    
    // SCHOOL LOGOS
    match /school_logos/{schoolId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
    }
    
    // TEACHER DOCUMENTS
    match /teacher_documents/{schoolId}/{teacherId}/{fileName} {
      // Scoped to same-school members (or the teacher themself, which doesn't
      // depend on the schoolId claim being populated) or super admin.
      // Previously any authenticated user from any school could read this path.
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId) || request.auth.uid == teacherId);
      allow write: if isSignedIn() && request.auth.uid == teacherId;
    }

    // LEAVE ATTACHMENTS
    match /leave_attachments/{schoolId}/{leaveId}/{fileName} {
      // Scoped to same-school members or super admin, matching the
      // corresponding firestore.rules `leaves` collection's own scoping
      // (allow create: if isSignedIn() && belongsToSchool(schoolId)).
      // Previously any authenticated user from any school could read AND
      // write here, relying only on the leaveId being "hard to guess".
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
      allow write: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
    }
    
    // PAYSLIPS
    match /payslips/{schoolId}/{payrollId}/{fileName} {
      allow read: if isSignedIn() && (isSuperAdmin() || (isActive() && belongsToSchool(schoolId)));
      allow write: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
    }
    
    // USER AVATARS
    match /user_avatars/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
    }
  }
}
