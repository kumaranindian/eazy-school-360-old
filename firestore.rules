rules_version = '2';
// Version: 1.0.1 - Added userMemberships collection rules
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isActive() {
      return isSignedIn() && hasUserDoc() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "ACTIVE"
      );
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function safeGetUserData() {
      return hasUserDoc() ? getUserData() : {};
    }
    
    function isSuperAdmin() {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == "SUPER_ADMIN" ||
        getUserData().role == "super_admin"
      );
    }
    
    function isAdmin() {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == "ADMIN" ||
        getUserData().role == "tenant_admin" ||
        getUserData().role == "admin"
      );
    }
    
    function isStaff() {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == "STAFF" ||
        getUserData().role == "TEACHER" ||
        getUserData().role == "teacher" ||
        getUserData().role == "staff"
      );
    }
    
    function isFinance() {
      return isSignedIn() && hasUserDoc() && (
        getUserData().role == "FINANCE" ||
        getUserData().role == "finance" ||
        getUserData().role == "user" ||
        getUserData().role == "accounts"
      );
    }
    
    function isAdminOrFinance() {
      return isAdmin() || isFinance();
    }
    
    // Legacy support
    function isTenantAdmin() {
      return isAdmin();
    }
    
    function isTeacher() {
      return isStaff();
    }
    
    function belongsToSchool(schoolId) {
      // Support both legacy (users/{uid}.schoolId) and multi-tenant (userMemberships/{uid}/schools/{schoolId})
      return isSignedIn() && (
        // Legacy: check users doc schoolId field
        (hasUserDoc() && getUserData().schoolId == schoolId) ||
        // Multi-tenant: check if membership doc exists
        exists(/databases/$(database)/documents/userMemberships/$(request.auth.uid)/schools/$(schoolId))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ============================================================
    // SCHOOLS COLLECTION
    // ============================================================
    match /schools/{schoolId} {
      // SIGNUP: Any authenticated user can CREATE a school (for registration)
      allow create: if isSignedIn();
      
      // READ: Super admin can read all, others can read their own school
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
      
      // UPDATE: Super admin or tenant admin of the school (must be active)
      allow update: if isSignedIn() && (isSuperAdmin() || (isActive() && isTenantAdmin() && belongsToSchool(schoolId)));
      
      // DELETE: Only super admin
      allow delete: if isSignedIn() && isSuperAdmin();
    }
    
    // ============================================================
    // SCHOOLS COLLECTION - SUBCOLLECTIONS
    // ============================================================
    match /schools/{schoolId} {
      // ADMIN USERS SUBCOLLECTION
      match /adminUsers/{adminId} {
        allow create: if isSignedIn() && request.auth.uid == adminId;
        allow read: if isSignedIn() && (isSuperAdmin() || request.auth.uid == adminId);
        allow update, delete: if isSignedIn() && isSuperAdmin();
      }
      
      // TEACHERS SUBCOLLECTION
      match /teachers/{teacherId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) || 
          (isTeacher() && request.auth.uid == teacherId)
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // STAFF SUBCOLLECTION (under schools)
      match /staff/{staffId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) || 
          (isStaff() && resource.data.userId == request.auth.uid)
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // LEAVE TYPES SUBCOLLECTION
      match /leaveTypes/{leaveTypeId} {
        allow read: if isSignedIn() && (isSuperAdmin() || isAdmin() || belongsToSchool(schoolId) || (isTeacher() && belongsToSchool(schoolId)));
        allow create, update: if isSignedIn() && (isSuperAdmin() || (isAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isAdmin() && belongsToSchool(schoolId)));
      }
      
      // LEAVES SUBCOLLECTION
      match /leaves/{leaveId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          // Staff/Teachers can read their own leaves (applicantId is the primary field used by the app)
          (isStaff() && belongsToSchool(schoolId) && (
            resource.data.applicantId == request.auth.uid ||
            resource.data.teacherId == request.auth.uid
          )) ||
          // Allow staff/teachers to list leaves collection for their school (more permissive without isActive)
          (isStaff() && belongsToSchool(schoolId))
        );
        allow create: if isSignedIn() && belongsToSchool(schoolId);
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          // Staff/Teachers can update their own leaves (cancel/request cancellation)
          (isStaff() && belongsToSchool(schoolId) && (
            resource.data.applicantId == request.auth.uid ||
            resource.data.teacherId == request.auth.uid
          ) && 
           (request.resource.data.status == 'cancellationRequested' || 
            request.resource.data.status == 'CANCELLATION_REQUESTED' ||
            (resource.data.status == 'PENDING' && request.resource.data.status == 'CANCELLED') ||
            (resource.data.status == 'pending' && request.resource.data.status == 'cancelled')))
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // LEAVE BALANCES SUBCOLLECTION
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /leaveBalances/{leaveBalanceId} {
        // READ: Staff can read their own balances, admins can read all
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          belongsToSchool(schoolId)
        );
        
        // WRITE: ONLY backend (Cloud Functions) can update balances
        // Staff CANNOT update balances directly - prevents tampering
        allow write: if false; // No client-side writes allowed
      }
      
      // SALARY STRUCTURES SUBCOLLECTION
      match /salaryStructures/{structureId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PAYROLL SUBCOLLECTION
      match /payroll/{payrollId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // ATTENDANCE SUBCOLLECTION
      match /attendance/{attendanceId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) || 
          (isTeacher() && belongsToSchool(schoolId))
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // SETTINGS SUBCOLLECTION
      match /settings/{settingId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSION SETTINGS SUBCOLLECTION
      match /permissionSettings/{settingId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSION REQUESTS SUBCOLLECTION (legacy - kept for backward compat)
      match /permissionRequests/{requestId} {
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.staffId == request.auth.uid ||
            resource.data.applicantId == request.auth.uid
          ))
        );
        allow create: if isSignedIn() && isActive() && belongsToSchool(schoolId);
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.staffId == request.auth.uid ||
            resource.data.applicantId == request.auth.uid
          ) && 
           (request.resource.data.status == 'cancellationRequested' || 
            request.resource.data.status == 'CANCELLATION_REQUESTED' ||
            (resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
            (resource.data.status == 'PENDING' && request.resource.data.status == 'CANCELLED')))
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // STAFF LEAVE BALANCES SUBCOLLECTION
      match /staffLeaveBalances/{balanceId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          // staffId is the staff doc ID; userId is the Firebase Auth UID
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.userId == request.auth.uid ||
            resource.data.staffId == request.auth.uid
          )) ||
          // Allow teachers to list staffLeaveBalances collection for their school
          (isTeacher() && belongsToSchool(schoolId))
        );
        
        allow create: if isSignedIn() && isActive() && (
          isSuperAdmin() ||
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            request.resource.data.userId == request.auth.uid ||
            request.resource.data.staffId == request.auth.uid
          ))
        );
        
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.userId == request.auth.uid ||
            resource.data.staffId == request.auth.uid
          ))
        );
        
        allow delete: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId))
        );
      }
      // STAFF PERMISSION BALANCES SUBCOLLECTION
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /staffPermissionBalances/{balanceId} {
        // READ: Staff can read their own balances, admins can read all
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          belongsToSchool(schoolId)
        );
        
        // WRITE: ONLY backend (Cloud Functions) can update balances
        // Staff CANNOT update balances directly - prevents tampering
        allow write: if false; // No client-side writes allowed
      }
      
      // PERMISSION MUTATIONS SUBCOLLECTION (audit trail)
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /permissionMutations/{mutationId} {
        // READ: Only admins can read audit trail
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId))
        );
        
        // WRITE: ONLY backend (Cloud Functions) can create mutations
        // Immutable audit trail - no client-side writes, no updates, no deletes
        allow create: if false; // No client-side creates allowed
        allow update: if false; // Immutable - no updates
        allow delete: if false; // Immutable - no deletes
      }
      
      // STAFF ENTITLEMENTS SUBCOLLECTION
      match /staffEntitlements/{entitlementId} {
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.staffId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ))
        );
        allow create, update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId))
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // LEAVE CANCELLATIONS SUBCOLLECTION
      match /leaveCancellations/{cancellationId} {
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.staffId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ))
        );
        allow create: if isSignedIn() && isActive() && belongsToSchool(schoolId) && (
          isSuperAdmin() ||
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && (
            request.resource.data.staffId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid
          ))
        );
        allow update: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)) || (isAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSION CANCELLATIONS SUBCOLLECTION
      match /permissionCancellations/{cancellationId} {
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.staffId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ))
        );
        allow create: if isSignedIn() && isActive() && belongsToSchool(schoolId) && (
          isSuperAdmin() ||
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isTeacher() && (
            request.resource.data.staffId == request.auth.uid ||
            request.resource.data.userId == request.auth.uid
          ))
        );
        allow update: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)) || (isAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // HOLIDAYS SUBCOLLECTION
      match /holidays/{holidayId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // ADMISSION PROVISIONING SUBCOLLECTION
      match /admissionProvisioning/{provisionId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // STUDENTS SUBCOLLECTION
      match /students/{studentId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // FEE STRUCTURES SUBCOLLECTION
      match /fee_structures/{structureId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // STUDENT FEE DETAILS SUBCOLLECTION
      match /student_fee_details/{detailId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }

      // FEE CATEGORIES SUBCOLLECTION — catalog of fee buckets (Tuition, Exam, Van, etc.)
      match /feeCategories/{categoryId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }

      // STUDENT FEE ITEMS — category-based fee tracking (new system)
      match /studentFeeItems/{itemId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }

      // AD-HOC FEE ASSIGNMENTS — bulk fee assignments for events
      match /adHocFeeAssignments/{assignmentId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId))) 
                      && request.resource.data.schoolId == schoolId;
        allow update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId))) 
                      && resource.data.schoolId == schoolId;
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId))) 
                      && resource.data.schoolId == schoolId;
      }

      // FEE STRUCTURES V2 (term-wise) — admin/finance manage; all signed-in school members can read.
      match /feeStructuresV2/{structureId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && isActive() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));

        // Per-structure terms.
        match /terms/{termId} {
          allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
          allow create, update, delete: if isSignedIn() && isActive() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        }
      }

      // STUDENT FEE LEDGERS (term-wise)
      match /studentFeeLedgers/{ledgerId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }

      // TERM FEE PAYMENTS (collected against ledgers)
      match /termFeePayments/{paymentId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }

      // FINANCE SETTINGS (receipt counter, defaults)
      match /financeSettings/{docId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }

      // PAYMENT TRANSACTIONS (Razorpay & Manual payments)
      match /payment_transactions/{transactionId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId) || isAdminOrFinance());
        allow create: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }

      // WHATSAPP NOTIFICATIONS (audit trail)
      match /whatsappNotifications/{notificationId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId) || isAdminOrFinance());
        allow create: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }

      // RAZORPAY SETTINGS
      match /settings/razorpay {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }

      // WHATSAPP SETTINGS
      match /settings/whatsapp {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }

      // UPI SETTINGS
      match /settings/upi {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // BILLS SUBCOLLECTION (Fee Payments & Expenses)
      match /bills/{billId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          belongsToSchool(schoolId) ||
          isAdminOrFinance()
        );
        allow create: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // CLASSES SUBCOLLECTION
      match /classes/{classId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSION TYPES SUBCOLLECTION
      match /permissionTypes/{permissionTypeId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSIONS SUBCOLLECTION (for permission requests)
      match /permissions/{permissionId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          // Teachers can read their own permissions by applicantId OR staffId
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.applicantId == request.auth.uid ||
            resource.data.staffId == request.auth.uid
          )) ||
          // Allow teachers to list permissions collection for their school (more permissive without isActive)
          (isTeacher() && belongsToSchool(schoolId))
        );
        // Teachers can create their own permission requests
        allow create: if isSignedIn() && isActive() && belongsToSchool(schoolId) && (
          isSuperAdmin() ||
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          request.resource.data.applicantId == request.auth.uid
        );
        allow update: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          // Teachers can cancel their own pending permissions
          (isTeacher() && belongsToSchool(schoolId) && (
            resource.data.applicantId == request.auth.uid ||
            resource.data.staffId == request.auth.uid
          ) && (
            request.resource.data.status == 'CANCELLED' ||
            request.resource.data.status == 'cancelled' ||
            request.resource.data.status == 'CANCELLATION_REQUESTED' ||
            request.resource.data.status == 'cancellationRequested'
          ))
        );
        allow delete: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // PERMISSION CONFIG SUBCOLLECTION
      match /permissionConfig/{configId} {
        allow read: if isSignedIn() && isActive() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow write: if isSignedIn() && isActive() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // MONTHLY PERMISSION USAGE SUBCOLLECTION
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /monthlyPermissionUsage/{usageId} {
        // READ: Staff can read their own usage, admins can read all
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          belongsToSchool(schoolId)
        );
        
        // WRITE: ONLY backend (Cloud Functions) can update usage
        // Staff CANNOT update usage directly - prevents tampering
        allow write: if false; // No client-side writes allowed
      }
      
      // ============================================================
      // RFID ATTENDANCE SYSTEM COLLECTIONS
      // ============================================================
      
      // DEVICES SUBCOLLECTION (RFID scanners)
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /devices/{deviceId} {
        // READ: Only admins can read device info
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId))
        );
        
        // WRITE: ONLY backend (Cloud Functions) can register devices
        allow write: if false; // No client-side writes allowed
      }
      
      // RFID CARDS SUBCOLLECTION (RFID to user mapping)
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /rfid_cards/{uid} {
        // READ: Only admins can read RFID mappings
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId))
        );
        
        // WRITE: ONLY backend (Cloud Functions) can register RFID cards
        allow write: if false; // No client-side writes allowed
      }
      
      // ATTENDANCE SUBCOLLECTION (Attendance records)
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /attendance/{attendanceId} {
        // READ: Staff can read their own attendance, admins can read all
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          belongsToSchool(schoolId)
        );
        
        // WRITE: ONLY backend (Cloud Functions) can create attendance records
        allow create: if false; // No client-side creates allowed
        allow update: if false; // Immutable - no updates
        allow delete: if false; // Immutable - no deletes
      }
      
      // DAILY ATTENDANCE SUMMARY SUBCOLLECTION
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /dailyAttendanceSummary/{summaryId} {
        // READ: Staff can read their own summary, admins can read all
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          belongsToSchool(schoolId)
        );
        
        // WRITE: ONLY backend (Cloud Functions) can create/update summaries
        allow write: if false; // No client-side writes allowed
      }
      
      // BALANCE MUTATIONS SUBCOLLECTION (audit trail)
      // 🔒 SECURE: Only backend (Cloud Functions) can write
      match /balanceMutations/{mutationId} {
        // READ: Only admins can read audit trail
        allow read: if isSignedIn() && isActive() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId))
        );
        
        // WRITE: ONLY backend (Cloud Functions) can create mutations
        // Immutable audit trail - no client-side writes, no updates, no deletes
        allow create: if false; // No client-side creates allowed
        allow update: if false; // Immutable - no updates
        allow delete: if false; // Immutable - no deletes
      }
      
      // AUDIT LOG SUBCOLLECTION
      match /auditLog/{logId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          (isAdmin() && belongsToSchool(schoolId))
        );
        // Only Cloud Functions and admins can write
        allow create: if isSignedIn() && (
          isSuperAdmin() || 
          (isAdmin() && belongsToSchool(schoolId))
        );
        allow update, delete: if false;
      }
      
      // ACADEMIC YEARS SUBCOLLECTION
      match /academicYears/{yearId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // FISCAL YEARS SUBCOLLECTION
      match /fiscalYears/{yearId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // ARREARS SUBCOLLECTION
      match /arrears/{arrearsId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId) || isAdminOrFinance());
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // STUDENT LEAVES SUBCOLLECTION
      match /studentLeaves/{leaveId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isStaff() && belongsToSchool(schoolId))
        );
        allow create: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow update: if isSignedIn() && (
          isSuperAdmin() || 
          (isTenantAdmin() && belongsToSchool(schoolId)) ||
          (isAdmin() && belongsToSchool(schoolId)) ||
          (isStaff() && belongsToSchool(schoolId))
        );
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // FEE STRUCTURES SUBCOLLECTION (alternative path)
      match /feeStructures/{structureId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // FEE COLLECTIONS SUBCOLLECTION
      match /feeCollections/{collectionId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId) || isAdminOrFinance());
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || (isTenantAdmin() && belongsToSchool(schoolId)));
      }
      
      // EXPENSE CATEGORIES SUBCOLLECTION
      match /expenseCategories/{categoryId} {
        allow read: if isSignedIn() && (isSuperAdmin() || belongsToSchool(schoolId));
        allow create, update: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin() || isFinance()) && belongsToSchool(schoolId)));
        allow delete: if isSignedIn() && (isSuperAdmin() || ((isTenantAdmin() || isAdmin()) && belongsToSchool(schoolId)));
      }
    }
    
    // ============================================================
    // ADMIN USERS COLLECTION (Top-level)
    // ============================================================
    match /adminUsers/{adminUserId} {
      // READ: Super admin can read all, tenant admin can read from their school
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && hasUserDoc() && belongsToSchool(resource.data.schoolId))
      );
      
      // CREATE: Only super admin can create admin users
      allow create: if isSignedIn() && isSuperAdmin();
      
      // UPDATE: Only super admin can update admin users
      allow update: if isSignedIn() && isSuperAdmin();
      
      // DELETE: Only super admin can delete admin users
      allow delete: if isSignedIn() && isSuperAdmin();
    }
    
    // ============================================================
    // TEACHERS COLLECTION (Top-level) - Legacy support
    // ============================================================
    match /teachers/{teacherId} {
      // READ: Authenticated users can read teachers from their school
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (getUserData().schoolId == resource.data.schoolId)
      );
      
      // CREATE: Super admin or tenant admin can create teachers
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == request.resource.data.schoolId)
      );
      
      // UPDATE: Super admin, tenant admin of same school, or the teacher themselves
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId) ||
        (isTeacher() && request.auth.uid == resource.data.userId)
      );
      
      // DELETE: Super admin or tenant admin of same school
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
    }
    
    // ============================================================
    // STAFF COLLECTION (Top-level) - New staff management
    // ============================================================
    match /staff/{staffId} {
      // Helper to check if user has a user document
      function hasUserDoc() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      
      // Helper to safely get user data
      function safeGetUserData() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      
      // READ: Authenticated users can read staff from their school
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && safeGetUserData().schoolId == resource.data.schoolId)
      );
      
      // CREATE: Super admin or tenant admin can create staff
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == request.resource.data.schoolId)
      );
      
      // UPDATE: Super admin, tenant admin of same school, the staff member themselves,
      // or a new user updating their own staff record (when userId is being set)
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && isTenantAdmin() && safeGetUserData().schoolId == resource.data.schoolId) ||
        (request.auth.uid == resource.data.userId) ||
        // Allow new user to update staff doc when setting their userId
        (request.auth.uid == request.resource.data.userId && request.resource.data.authCreated == true)
      );
      
      // DELETE: Super admin or tenant admin of same school
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
    }
    
    // ============================================================
    // ADMIN USERS COLLECTION (Top-level) - Admin provisioning
    // ============================================================
    match /adminUsers/{adminId} {
      // READ: Any authenticated user can read their own admin record,
      // Super admin can read all, tenant admin can read admins from their school
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.userId ||
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
      
      // CREATE: Super admin, tenant admin for their school, OR the user creating their own record
      // (needed because Firebase Auth auto-signs in as new user after createUserWithEmailAndPassword)
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == request.resource.data.userId ||
        (isTenantAdmin() && getUserData().schoolId == request.resource.data.schoolId)
      );
      
      // UPDATE: Super admin, tenant admin of same school, or user updating their own record
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == resource.data.userId ||
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
      
      // DELETE: Super admin or tenant admin of same school
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
    }
    
    // ============================================================
    // LEAVE REQUESTS COLLECTION (Top-level) - For staff leave applications
    // ============================================================
    match /leaveRequests/{requestId} {
      // READ: Super admin, tenant admin of school, or the staff member who applied
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId) ||
        request.auth.uid == resource.data.staffId
      );
      
      // CREATE: Any authenticated staff member can apply for leave
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.staffId &&
        getUserData().schoolId == request.resource.data.schoolId;
      
      // UPDATE: Super admin, tenant admin (for approval), or staff member (for cancellation)
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId) ||
        (request.auth.uid == resource.data.staffId && (
          resource.data.status == 'pending' || 
          (resource.data.status == 'approved' && request.resource.data.status == 'cancellationRequested')
        ))
      );
      
      // DELETE: Super admin or tenant admin
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        (isTenantAdmin() && getUserData().schoolId == resource.data.schoolId)
      );
    }
    
    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      // CREATE: User can create their own document OR admin can create finance/staff users
      // When admin creates a staff user via createUserWithEmailAndPassword,
      // Firebase auto-signs in as the new user. So the new user creates their own doc.
      // We allow this if:
      // 1. User is creating their own document (request.auth.uid == userId)
      // 2. OR admin is creating a finance/staff user (with proper role validation)
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (isTenantAdmin() && request.resource.data.role in ['FINANCE', 'STAFF'] && request.resource.data.schoolId == getUserData().schoolId)
      );
      
      // READ: User can read their own data, super admin can read all, tenant admin can read users from their school
      // Also allow tenant admins to query users collection for email validation
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (isTenantAdmin() && (
          resource.data.schoolId == getUserData().schoolId ||
          request.query != null
        )) ||
        // Allow admin users to query for email validation
        (isSignedIn() && request.query != null && request.query.limit <= 5)
      );
      
      // UPDATE: User can update their own data, super admin can update all, tenant admin can update users from their school
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (isTenantAdmin() && resource.data.schoolId == getUserData().schoolId)
      );
      
      // DELETE: Only super admin
      allow delete: if isSignedIn() && isSuperAdmin();
      
      // NOTIFICATIONS SUBCOLLECTION
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && (isSuperAdmin() || isTenantAdmin());
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    // ============================================================
    // RFID CARDS COLLECTION
    // ============================================================
    match /schools/{schoolId}/rfid_cards/{cardId} {
      // READ: Admin and finance users from the same school can read
      allow read: if isSignedIn() && belongsToSchool(schoolId) && isAdminOrFinance();
      
      // CREATE: Admin users from the same school can create
      // Additional validation: UUID must be unique within the school
      allow create: if isSignedIn() && belongsToSchool(schoolId) && isAdmin() &&
        request.resource.data.schoolId == schoolId &&
        request.resource.data.uuid is string &&
        request.resource.data.staffId is string &&
        request.resource.data.cardType in ['primary', 'backup'];
      
      // UPDATE: Admin users from the same school can update
      allow update: if isSignedIn() && belongsToSchool(schoolId) && isAdmin() &&
        resource.data.schoolId == schoolId;
      
      // DELETE: Admin users from the same school can delete
      allow delete: if isSignedIn() && belongsToSchool(schoolId) && isAdmin() &&
        resource.data.schoolId == schoolId;
    }
    
    // ============================================================
    // USER MEMBERSHIPS COLLECTION (Multi-tenant)
    // ============================================================
    match /userMemberships/{uid}/schools/{schoolId} {
      // CREATE: Admin can create memberships for users in their school
      // Admin must belong to the school they're creating membership for
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isActive() && isAdmin() && belongsToSchool(schoolId))
      );

      // READ: User can read their own memberships, super admin can read all, tenant admin can read from their school
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isAdmin() && schoolId == getUserData().schoolId)
      );

      // UPDATE: Super admin or tenant admin can update memberships
      allow update: if isSignedIn() && isActive() && (
        isSuperAdmin() ||
        (isAdmin() && belongsToSchool(schoolId))
      );

      // DELETE: Super admin or tenant admin can delete memberships
      allow delete: if isSignedIn() && isActive() && (
        isSuperAdmin() ||
        (isAdmin() && belongsToSchool(schoolId))
      );
    }

    // ============================================================
    // MEMBERSHIPS COLLECTION (Legacy)
    // ============================================================
    match /memberships/{membershipId} {
      // CREATE: Admin can create memberships for finance/staff users
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (isTenantAdmin() && request.resource.data.schoolId == getUserData().schoolId)
      );
      
      // READ: User can read their own memberships, super admin can read all, tenant admin can read from their school
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.uid ||
        isSuperAdmin() ||
        (isTenantAdmin() && resource.data.schoolId == getUserData().schoolId)
      );
      
      // UPDATE: Super admin or tenant admin can update memberships
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isTenantAdmin() && resource.data.schoolId == getUserData().schoolId)
      );
      
      // DELETE: Super admin or tenant admin can delete memberships
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isTenantAdmin() && resource.data.schoolId == getUserData().schoolId)
      );
    }
  }
}
