{
	"info": {
		"name": "Eazy School 360 - Firebase Cloud Functions",
		"_postman_id": "eazy-school-360-cloud-functions",
		"description": "Collection to test Firebase Cloud Functions for Eazy School 360",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://us-central1-eazyschool-360-dev.cloudfunctions.net",
			"type": "string"
		},
		{
			"key": "rfidBaseUrl",
			"value": "https://asia-south1-eazyschool-360-dev.cloudfunctions.net",
			"type": "string"
		},
		{
			"key": "schoolId",
			"value": "YOUR_SCHOOL_ID",
			"type": "string",
			"description": "Your school ID from Firestore"
		},
		{
			"key": "phoneNumber",
			"value": "+918508196981",
			"type": "string",
			"description": "Default phone number for updates"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string",
			"description": "Firebase Auth ID token - Get this from the 'Get Auth Token' request"
		},
		{
			"key": "apiKey",
			"value": "YOUR_FIREBASE_API_KEY",
			"type": "string",
			"description": "Firebase API Key from Project Settings"
		},
		{
			"key": "adminEmail",
			"value": "admin@example.com",
			"type": "string",
			"description": "Admin email for authentication"
		},
		{
			"key": "adminPassword",
			"value": "YOUR_PASSWORD",
			"type": "string",
			"description": "Admin password for authentication"
		},
		{
			"key": "deviceKey",
			"value": "YOUR_DEVICE_KEY",
			"type": "string",
			"description": "Device key for RFID authentication"
		},
		{
			"key": "deviceId",
			"value": "YOUR_DEVICE_ID",
			"type": "string",
			"description": "Device ID for RFID authentication"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Get Firebase Auth Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extract and save the idToken to collection variables",
									"if (pm.response.json().idToken) {",
									"    pm.collectionVariables.set(\"authToken\", pm.response.json().idToken);",
									"    console.log(\"Auth token saved successfully\");",
									"} else {",
									"    console.log(\"Failed to extract auth token\");",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{apiKey}}",
							"protocol": "https",
							"host": ["identitytoolkit", "googleapis", "com"],
							"path": ["v1", "accounts:signInWithPassword"],
							"query": [
								{
									"key": "key",
									"value": "{{apiKey}}"
								}
							]
						},
						"description": "Sign in to Firebase and get ID token. Update the adminEmail and adminPassword variables, then run this first. The token will be automatically saved to the authToken variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. RFID & Attendance Functions",
			"item": [
				{
					"name": "Register Device",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-device-key",
								"value": "{{deviceKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"deviceName\": \"RFID Reader 1\",\n  \"deviceType\": \"RFID_READER\",\n  \"location\": \"Main Gate\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{rfidBaseUrl}}/rfidApi/register-device",
							"host": ["{{rfidBaseUrl}}"],
							"path": ["rfidApi", "register-device"]
						},
						"description": "Register a new RFID device for attendance"
					},
					"response": []
				},
				{
					"name": "Register RFID Card",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-device-key",
								"value": "{{deviceKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"rfidTag\": \"TAG1234567890\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{rfidBaseUrl}}/rfidApi/register-rfid",
							"host": ["{{rfidBaseUrl}}"],
							"path": ["rfidApi", "register-rfid"]
						},
						"description": "Register an RFID card to a device (unassigned). Staff/student mapping is done separately in Flutter UI."
					},
					"response": []
				},
				{
					"name": "Mark Attendance",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-device-key",
								"value": "{{deviceKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"rfidTag\": \"TAG1234567890\",\n  \"timestamp\": \"2025-05-06T12:00:00Z\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{rfidBaseUrl}}/rfidApi/mark-attendance",
							"host": ["{{rfidBaseUrl}}"],
							"path": ["rfidApi", "mark-attendance"]
						},
						"description": "Mark attendance for a staff/student based on RFID tag mapping (requires device key auth)"
					},
					"response": []
				},
				{
					"name": "Process RFID Swipe (Callable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"schoolId\": \"{{schoolId}}\",\n    \"rfidTag\": \"TAG1234567890\",\n    \"timestamp\": \"2025-05-06T12:00:00Z\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{rfidBaseUrl}}/processRfidSwipe",
							"host": ["{{rfidBaseUrl}}"],
							"path": ["processRfidSwipe"]
						},
						"description": "Process RFID swipe (callable function)"
					},
					"response": []
				}
			]
		},
